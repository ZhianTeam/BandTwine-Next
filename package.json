{
  "name": "bandtwine-ng",
  "version": "2.0.0-alpha",
  "description": "Twine UNOFFICIAL Port for Xiaomi Smart Watch/Band.",
  "engines": {
    "node": ">=20.00"
  },
  "scripts": {
    "start": "aiot server --watch --open-nuttx",
    "build": "aiot build --enable-jsc --enable-protobuf",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/",
    "release": "aiot release --enable-image-png8 --enable-protobuf --enable-jsc",
    "watch": "aiot watch --open-nuttx"
  },
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "aiot-toolkit": "2.0.5",
    "conditional-compilation-webpack-plugin": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-ux": "^0.0.4",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "less-loader": "^13.0.0",
    "lint-staged": "^17.2.0",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "ux-types": "^1.7.0"
  },
  "dependencies": {
    "@aiot-toolkit/jsc": "^1.0.8",
    "@babel/preset-react": "^8.0.1",
    "vitepress": "^1.6.4"
  }
}
