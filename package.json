{
  "name": "bandtwine-ng",
  "type": "module",
  "version": "2.0.0-alpha",
  "description": "Twine UNOFFICIAL Port for Xiaomi Smart Watch/Band.",
  "author": [
    "ZhianTeam <noreply@zhian.org>",
    "Yaowen Fan <maoxian666@outlook.com>",
    "Catndroid <sakuraforx@foxmail.com>",
    "OrPudding <133682101+OrPudding@users.noreply.github.com>"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "aiot server --watch --open-nuttx",
    "build": "aiot build --enable-jsc --enable-protobuf",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/",
    "release": "aiot release --enable-image-png8 --enable-protobuf --enable-jsc",
    "watch": "aiot watch --open-nuttx"
  },
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.8",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.6.0",
    "aiot-toolkit": "2.0.5",
    "conditional-compilation-webpack-plugin": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-ux": "^0.0.4",
    "husky": "^9.1.7",
    "less": "^4.8.1",
    "less-loader": "^13.0.0",
    "lint-staged": "^15.4.3",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "ux-types": "^1.7.0"
  },
  "dependencies": {
    "@aiot-toolkit/jsc": "^1.0.8",
    "@babel/preset-react": "^7.26.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "eslint-plugin-ux": {
      "eslint": "$eslint"
    }
  }
}
